{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "app/globals.css",
    "functions": ["cn", "cva"]
  },
  "ignorePatterns": [
    ".worktrees/",
    ".agents/",
    ".claude/",
    ".next/",
    ".pnpm-store/",
    ".turbo/",
    "convex/_generated/",
    "coverage/",
    "dist/",
    "node_modules/",
    "pnpm-lock.yaml"
  ]
}
