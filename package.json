{
  "name": "impact-coaching-center",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "next build",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "demo": "bun run otp & bun run dev",
    "dev": "next dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "materials:docs": "bun scripts/generate-final-quotation.mjs && bun scripts/generate-client-materials.mjs",
    "materials:pdf": "bun scripts/materials-to-pdf.mjs",
    "otp": "bun run scripts/otp.ts",
    "seed:dev": "bun run scripts/seed-dev.ts",
    "start": "next start",
    "sync:courses": "bun run scripts/sync-courses.ts",
    "test": "bun test",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "smoke": "bun run scripts/smoke.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@convex-dev/better-auth": "0.12.6",
    "@convex-dev/r2": "^0.10.4",
    "@fontsource-variable/anek-bangla": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-table": "^9.3.1",
    "better-auth": "1.6.33",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "convex": "^1.48.0",
    "input-otp": "^1.5.0",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "6.4.299",
    "posthog-js": "1.438.24",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.3",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "convex-test": "^0.0.65",
    "docx": "^9.14.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "pptxgenjs": "4.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "patchedDependencies": {
    "next-themes@0.4.6": "patches/next-themes@0.4.6.patch"
  },
  "overrides": {
    "@better-fetch/fetch": "1.3.1"
  }
}
