# Copy to .env.local for development. .env.local is gitignored.
#
# Nothing here is a secret except BETTER_AUTH_SECRET, which is set on the
# Convex deployment rather than in this file.

# ---------------------------------------------------------------------------
# Build environment (the host's project settings: Vercel, Netlify, Cloudflare)
# ---------------------------------------------------------------------------

# Where this build lives. Required whenever SITE_INDEXABLE is true, because
# the fallback is localhost and that would be published to search engines.
# Next inlines NEXT_PUBLIC_* at build time, so this must be set at build, not
# only at runtime.
NEXT_PUBLIC_SITE_URL=

# Off until launch. The site carries offers the owner has not yet confirmed,
# so it must not be indexed as ICT's official site.
SITE_INDEXABLE=false

# Written by `convex dev`. Point these at the production deployment when
# deploying. A missing value now fails the first request that needs auth,
# with the variable named, rather than failing the build.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Optional. Without it, an enquiry is logged (without personal details) and
# not delivered anywhere.
LEAD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Convex deployment (set with `npx convex env set NAME value`, not here)
# ---------------------------------------------------------------------------
#
#   SITE_URL             Must equal NEXT_PUBLIC_SITE_URL. Anchors CORS and
#                        CSRF trust for the auth routes.
#   BETTER_AUTH_SECRET   Generate with: openssl rand -base64 32
#   OTP_TRANSPORT        "logger" or "whatsapp". No default: unset fails
#                        closed, because the Phone Number plugin stores a
#                        verification code even when delivery does nothing,
#                        so a silent fallback would accept a code nobody
#                        received. "whatsapp" is not implemented yet.
